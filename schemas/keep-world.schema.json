{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jasandroidx/ravenstack-keep/blob/ravenstack/schemas/keep-world.schema.json",
  "title": "Keep world — keep-world.json",
  "description": "The single world model for the Keep: painted rooms (Ledger + map zone), map-only places, Ledger rooms with no painting yet, and the NPCs that stand in them. Ids are the only key. Lock state and occupancy at runtime come from the box (keep.db / /api/duty / pulse), never from this file. Cross-entry rules (unique ids, zone order, spec existence, WALK coverage) are asserted in ui-v2/src/lib/keep/world.test.ts — a JSON Schema cannot express them.",
  "type": "object",
  "required": ["schema", "map", "zoneOrder", "rooms", "mapOnly", "unplaced", "npcs"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "keep-world.v1" },
    "map": {
      "type": "object",
      "required": ["src", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string", "pattern": "^/hall/" },
        "w": { "const": 1792 },
        "h": { "const": 1008 }
      }
    },
    "zoneOrder": {
      "type": "array",
      "description": "Precedence for zone lookups, first match wins. The Grand Gallery must follow the Great Hall, or the hall's rect swallows the archway.",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "uniqueItems": true
    },
    "rooms": {
      "type": "array",
      "description": "Painted rooms with a Ledger row. Every one needs a zone.",
      "items": { "$ref": "#/definitions/paintedRoom" }
    },
    "mapOnly": {
      "type": "array",
      "description": "Painted places with no Ledger row (e.g. the Quarantine Cell, the Grand Gallery arch).",
      "items": { "$ref": "#/definitions/place" }
    },
    "unplaced": {
      "type": "array",
      "description": "Ledger rooms with a real capability and no painted floor yet (e.g. armory, roost). Listing them here is honest; inventing a zone for them is not.",
      "items": {
        "allOf": [{ "$ref": "#/definitions/ledgerRoom" }, { "type": "object", "required": ["note"] }]
      }
    },
    "npcs": {
      "type": "array",
      "description": "Everyone who can be walked up to. `place` names the room or map-only place they stand in, which may differ from the room's own occupant (Corvid stands in the yard).",
      "items": { "$ref": "#/definitions/npc" }
    }
  },
  "definitions": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1792 },
        "y": { "type": "number", "minimum": 0, "maximum": 1008 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "ledger": {
      "type": "object",
      "required": ["occupant", "role", "lock", "purpose", "kill"],
      "additionalProperties": false,
      "properties": {
        "occupant": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "lock": { "type": "string", "enum": ["live", "unforged", "locked"] },
        "purpose": {
          "type": "string",
          "minLength": 10,
          "description": "Exactly one sentence. AGENTS.md: one agent, one purpose sentence."
        },
        "kill": {
          "type": "string",
          "minLength": 10,
          "description": "Mandatory kill condition. A room without one is not a room."
        }
      }
    },
    "pulse": {
      "type": "object",
      "required": ["boxIds", "slugs"],
      "additionalProperties": false,
      "description": "Reconciliation table: what the box calls this room, and every slug any endpoint may use for it.",
      "properties": {
        "boxIds": { "type": "array", "items": { "type": "string" } },
        "slugs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "ledgerRoom": {
      "type": "object",
      "required": ["id", "name", "wing", "ledger", "spec", "specStatus", "href", "modelDefault", "col", "row", "pulse"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "wing": { "type": "string", "minLength": 1 },
        "ledger": { "$ref": "#/definitions/ledger" },
        "spec": {
          "type": ["string", "null"],
          "description": "Key into catalog.SPECS (and agents/<id>.agent-spec.json), or null when no agent occupies it."
        },
        "specStatus": { "type": "string", "enum": ["draft", "approved", "live", "retired"] },
        "href": { "type": ["string", "null"], "description": "Route the room links to, or null." },
        "image": { "type": "string", "pattern": "^/" },
        "modelDefault": { "type": "string", "enum": ["local", "escalate", "god"] },
        "col": { "type": "integer", "minimum": 1, "maximum": 3 },
        "row": { "type": "integer", "minimum": 1, "maximum": 4 },
        "pulse": { "$ref": "#/definitions/pulse" },
        "note": { "type": "string" }
      }
    },
    "paintedRoom": {
      "allOf": [
        { "$ref": "#/definitions/ledgerRoom" },
        { "type": "object", "required": ["zone"], "properties": { "zone": { "$ref": "#/definitions/rect" } } }
      ]
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "lock", "zone", "note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "lock": {
          "type": "string",
          "enum": ["live", "unforged", "locked"],
          "description": "Door state for the map. A place has no Ledger row, so it cannot inherit one."
        },
        "href": { "type": "string", "pattern": "^/" },
        "zone": { "$ref": "#/definitions/rect" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "npc": {
      "type": "object",
      "required": ["id", "name", "role", "place", "x", "y", "radius", "greeting"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "place": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "radius": { "type": "number", "minimum": 1 },
        "actor": { "type": "string", "pattern": "^/hall/sprites/" },
        "actorH": { "type": "number", "minimum": 1 },
        "talkScene": { "type": "string", "pattern": "^/hall/" },
        "portrait": { "type": "string", "pattern": "^/hall/" },
        "href": { "type": "string", "pattern": "^/" },
        "greeting": { "type": "string", "minLength": 1 }
      }
    }
  }
}
