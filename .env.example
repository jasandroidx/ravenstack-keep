# Ravenstack Keep — model + MCP routing.
# Local-first is the default: with none of these set the app talks to Ollama on
# 127.0.0.1:11434 and never spends a cent. Never commit a real key or a Funnel URL.

# --- Local inference (Ollama) ------------------------------------------------
# Full URL or bare host:port. Point at the box over Tailscale if it runs there.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Pin one model. Unset = first preferred chat tag installed (embed-only tags are skipped).
KEEP_LOCAL_MODEL=
# Cold local models are slow, not broken. Default 120000.
KEEP_LOCAL_TIMEOUT_MS=

# --- Routing -----------------------------------------------------------------
# local-first (default) | local | cloud-first | cloud
KEEP_MODEL_ROUTE=local-first
# 0 hard-disables the cloud leg even when a key is present.
KEEP_ALLOW_CLOUD=
# Cloud fallback model id. Verify this against the installed @google/genai SDK.
KEEP_CLOUD_MODEL=

# --- Fortress MCP ------------------------------------------------------------
# Must end in /mcp. Prefer loopback or Tailscale, never a public Funnel URL.
MCP_BASE_URL=http://127.0.0.1:8100/mcp
# Optional bearer. Redacted in every error path — keep it out of git.
MCP_AUTH_TOKEN=
MCP_TIMEOUT_MS=

# --- Pulse fallback ----------------------------------------------------------
# Only used when MCP dashboard_status is unavailable. Same-network only.
KEEP_PULSE_URL=

# --- Cloud credential (optional) ---------------------------------------------
# Leave blank to stay fully local.
GEMINI_API_KEY=
