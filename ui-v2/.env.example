# Copy to .env on the box. Never commit .env.

# s1-lock-doors identity gate (see src/lib/auth/tailscale-gate.ts).
# Comma-separated Tailscale-User-Login values allowed through Tailscale serve.
# Default when unset: the single operator login (jasonmboyd87@gmail.com).
# KEEP_ALLOWED_LOGINS=jasonmboyd87@gmail.com
# Secret bearer for tagged devices bypassing Tailscale serve. Generate with
# `openssl rand -hex 32` and NEVER commit it. Empty = that path is locked off.
# KEEP_INTERNAL_TOKEN=

# Hall + Ledger work without any of these.
VITE_AUTH_ENABLED=false

# Optional Postgres. Unset = PGLite (fine for a single-operator box).
# DATABASE_URL=postgres://keep:keep@postgres:5432/keep

# Optional. Only if you still want Grok talk/Forge in this UI.
# XAI_API_KEY=

# Live pulse. Point at Keep's own HTTP API (127.0.0.1:8112/api/castle-map on
# the box; see http_api.py) or a tiny proxy you own. Leave unset to serve the
# paper fixture (honest "paper" badge). Do NOT put a Funnel secret path here.
# KEEP_PULSE_URL=http://127.0.0.1:8112/api/castle-map

# Shift Board (duty) — Keep's own HTTP API, not Funnel, not ReClaw.
# On the box: ravenstack-keep-http.service listens on 127.0.0.1:8112.
# Leave unset = http://127.0.0.1:8112. The board fails closed when unreadable.
# KEEP_HTTP_URL=http://127.0.0.1:8112

# Later: MCP streamable HTTP on the docker network (reclaw-platform :8100).
# KEEP_MCP_URL=http://reclaw-mcp:8100/mcp

# --- FastMCP bridge (required for the Sentinel / Mechanic panels) ---
# Endpoints are NEVER committed. Set them here on the box.
# With none set, the bridge reports "unreachable" and the panels stay empty —
# by design. This app does not synthesise county ledgers or Oracle citations.
# FASTMCP_FUNNEL_URL=https://<your-openclaw-host>
# Use the MagicDNS hostname, not the raw tailnet IP: Tailscale issues certs for
# the hostname, so the IP form fails verification. Port 8100 is HTTPS.
# FASTMCP_INTERNAL_URL=https://<machine>.<tailnet>.ts.net:8100/mcp
# RECLAW_API_BASE=http://<tailnet-ip>:8000
# OPENCLAW_GATEWAY_WS=ws://<tailnet-ip>:18789
