{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "obsidian-mcp@2",
        "serve",
        "--vault",
        "notes=${OBSIDIAN_VAULT:-/root/obsidian_vault}"
      ]
    }
  }
}
